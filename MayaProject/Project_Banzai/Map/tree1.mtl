Wavefront OBJ material file
# Contains 3 materials

newmtl dark_oak_leaves
Ns 0
Ka 0.2 0.2 0.2
Kd 1 1 1
Ks 0 0 0
map_Ka tex/dark_oak_leaves_y.png
# for G3D, to make textures look blocky:
interpolateMode NEAREST_MAGNIFICATION_TRILINEAR_MIPMAP_MINIFICATION
map_Kd tex/dark_oak_leaves_y.png
map_d tex/dark_oak_leaves_y.png
illum 2
# d 1
# Tr 0

